            "text": "<div>\r\n    <div class=\"mi-map-filters\" id=\"widget_container_all\">\r\n        <img src=\"/img/new-theme-imgs/filter-image.png\" id=\"imgHeaderWidget\" alt=\"Filtro\" class=\"mi-map-filters__image\">\r\n        <header class=\"mi-map-filters__header\">\r\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10.347\" height=\"14.782\" viewBox=\"0 0 10.347 14.782\">\r\n                <path id=\"Caminho_2428\" data-name=\"Caminho 2428\"\r\n                      d=\"M15.174,4A5.175,5.175,0,0,0,10,9.174c0,3.88,5.174,9.608,5.174,9.608s5.174-5.728,5.174-9.608A5.175,5.175,0,0,0,15.174,4Zm0,7.021a1.848,1.848,0,1,1,1.848-1.848A1.848,1.848,0,0,1,15.174,11.021Z\"\r\n                      transform=\"translate(-10 -4)\" fill=\"#069169\" />\r\n            </svg>\r\n            <div id=\"customTitleDiv\" data-dojo-attach-point=\"customTitleDiv\">\r\n                <p class=\"mi-map-filters__text\">\r\n                    ${i18n.EstaViendo}: <span data-dojo-attach-point=\"customTitleLabel\">--</span>\r\n                </p>\r\n                <div style=\"font-weight: normal; padding: 0 0 0 0; margin: -13px 0 0 0;\">\r\n                    <span data-dojo-attach-point=\"customTitleLabelAux\"></span>\r\n                </div>\r\n            </div>\r\n        </header>\r\n        <div class=\"mi-map-filters__body\">\r\n            <p class=\"mi-map-filters__projects-number\">\r\n            </p>\r\n            <div class=\"mi-map-filters__buttons\">\r\n                <button class=\"mi-button\" data-dojo-attach-event=\"onClick:viewFiltersAction\">\r\n                    <svg class=\"mi-button__icon\" xmlns=\"http://www.w3.org/2000/svg\" width=\"12.768\" height=\"12.768\"\r\n                         viewBox=\"0 0 12.768 12.768\">\r\n                        <path id=\"Caminho_9303\" data-name=\"Caminho 9303\"\r\n                              d=\"M51-11.07v1.419h4.256V-11.07Zm0-8.512v1.419h7.093v-1.419ZM58.093-8.232V-9.651h5.674V-11.07H58.093v-1.419H56.674v4.256Zm-4.256-8.512v1.419H51v1.419h2.837v1.419h1.419v-4.256Zm9.93,2.837v-1.419H56.674v1.419Zm-4.256-2.837H60.93v-1.419h2.837v-1.419H60.93V-21H59.512Z\"\r\n                              transform=\"translate(-51 21)\" fill=\"#fff\" />\r\n                    </svg>\r\n                    Filtros\r\n                </button>\r\n                <button class=\"mi-button\" data-action=\"close-filter\" data-dojo-attach-event=\"onClick:filterClearAction\"\r\n                        data-dojo-props=\"label:'${i18n.BorrarFiltros}',className:'buttonSmall'\"\r\n                        data-dojo-attach-point=\"linkFilterClear\">\r\n                    <svg class=\"mi-button__icon\" xmlns=\"http://www.w3.org/2000/svg\" width=\"12.251\" height=\"13.774\"\r\n                         viewBox=\"0 0 12.251 13.774\">\r\n                        <g id=\"Grupo_5367\" data-name=\"Grupo 5367\" transform=\"translate(0 -1)\">\r\n                            <g id=\"Grupo_5335\" data-name=\"Grupo 5335\" transform=\"translate(4.118 5.733)\">\r\n                                <line id=\"Linha_52\" data-name=\"Linha 52\" y2=\"6.682\" fill=\"none\" stroke=\"#36c\" stroke-width=\"1\" />\r\n                                <line id=\"Linha_53\" data-name=\"Linha 53\" y2=\"6.682\" transform=\"translate(3.956)\" fill=\"none\"\r\n                                      stroke=\"#36c\" stroke-width=\"1\" />\r\n                                <line id=\"Linha_54\" data-name=\"Linha 54\" y2=\"6.682\" transform=\"translate(1.978)\" fill=\"none\"\r\n                                      stroke=\"#36c\" stroke-width=\"1\" />\r\n                            </g>\r\n                            <path id=\"Caminho_28\" data-name=\"Caminho 28\"\r\n                                  d=\"M38.769,1.982H35.9V1.515A1.517,1.517,0,0,0,34.388,0H31.663a1.517,1.517,0,0,0-1.515,1.515v.467H27.282a.382.382,0,0,0,0,.765h.691V11.73a2.047,2.047,0,0,0,2.045,2.045h6.015a2.047,2.047,0,0,0,2.045-2.045V2.747h.691a.382.382,0,1,0,0-