            "mimeType": "text/html",
            "compression": 0,
            "text": "﻿<div class=\"container-recursos-card\">\r\n    <div class=\"typeB-card recursos_general\" onclick=\"functionClickEye([ONCLICK])\" id=\"[ID]\">\r\n        <div class=\"is-selected\"><span class=\"icon-checked icon\"></span></div>\r\n        <div class=\"typeB-card__body\">\r\n            <p class=\"h7 typeB-card__element\"><span class=\"card-title\">[GRUPO_RECURSO]</span></p>\r\n            <div class=\"typeB-card__data\">\r\n                <div class=\"typeB-card__data__item\" title=\"[TOTAL_PRESUPUESTADO_NUM]\">\r\n                    <p class=\"title\">Recursos Aprobados</p>\r\n                    <p class=\"h9\">$[TOTAL_PRESUPUESTADO]</p>\r\n                </div>\r\n                <div class=\"typeB-card__data__item\" title=\"[PRESUPUESTO_EJECUTADO_NUM]\">\r\n                    <p class=\"title\">Recursos Ejecutados</p>\r\n                    <p class=\"h9\">$[PRESUPUESTO_EJECUTADO]</p>\r\n                </div>\r\n            </div>\r\n            <div class=\"typeB-card__data\">\r\n                <div class=\"typeB-card__data__item\">\r\n                    <p class=\"title\">Proyectos</p>\r\n                    <p class=\"h9\">[PROYECTOS_EJECUTADOS]</p>\r\n                </div>\r\n                <div class=\"typeB-card__data__item\">\r\n                    <p class=\"title\">Sector Mayor Recursos Aprobados</p>\r\n                    <p class=\"h9\">[SECTOR]</p>\r\n                </div>\r\n            </div>\r\n            <div id=\"displayBienioSGR\" class=\"typeB-card__data\" style=\"display:none;\">\r\n                <div class=\"typeB-card__data__item\">\r\n                    <p class=\"title\">Vigencia</p>\r\n                    <p class=\"h9\">[BIENIOS]</p>\r\n                </div>\r\n                <div class=\"typeB-card__data__item\">\r\n                  \r\n                </div>\r\n            </div>\r\n        </div>\r\n        <a href=\"javascript: top.abrirFichaRecurso('[VIGENCIA]','[SECTOR_FICHA]','[GRUPO_RECURSO_FICHA]','[DEPARTAMENTO]','[NOMBRE_DEPARTAMENTO]','[TIPOLUGAR]','[VALORLUGAR]')\" class=\"typeB-card__see-more\">\r\n            Ver m&aacute;s <span class=\"icon-right\"></span>\r\n        </a>\r\n    </div>\r\n</div>"
          },
