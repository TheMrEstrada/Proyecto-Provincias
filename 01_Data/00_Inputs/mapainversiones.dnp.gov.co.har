            "size": 1504,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<div class=\"helpDijit\">\r\n    <div data-dojo-type=\"dijit/layout/ContentPane\" data-dojo-attach-point=\"containerNode\" class=\"helpContainer\">\r\n        <div class=\"helpNode\">\r\n            <div data-dojo-type=\"dijit.layout.ContentPane\" id=\"rightPane\" data-dojo-props=\"region:'right'\">\r\n                <div style='padding-left:4px;'>\r\n                    <p>\r\n                        <span><strong>Debe Agregar Archivos ZIP que contienen los archivos shp, dbf y shx</strong></span>\r\n                    </p>\r\n                    <form enctype=\"multipart/form-data\" method=\"post\" id=\"uploadForm\">\r\n                        <label class=\"file-upload\">\r\n                            <span><strong>Seleccionar Archivo</strong></span>\r\n                            <input type=\"file\" name=\"file\" id=\"inFile\" />\r\n                        </label>\r\n                        <button id=\"btnClearShape\" data-dojo-type=\"dijit/form/Button\"\r\n                                data-dojo-attach-event=\"onClick:filterClearAction\"\r\n                                data-dojo-props=\"label:'Limpiar', style:'width:100px;'\"\r\n                                data-dojo-attach-point=\"btnClearShape,\">\r\n                            <div></div>\r\n                        </button>\r\n                    </form>\r\n                    <span class=\"file-upload-status\" style=\"opacity:1;\" id=\"upload-status\"></span>\r\n                    <div id=\"fileInfo\">&nbsp;</div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n"
          },
          "redirectURL": "",
          "headersSize": 277,
          "bodySize": 1504,
