# ============================================================
# Proyecto-Provincias — .gitignore
# ============================================================

# --- Archivos muy grandes (fuentes que no caben en GitHub) ---
# Pedirlas al equipo; ver README (sección "Fuentes ausentes del clon")
01_Data/00_Inputs/EMPAQUETAMIENTO_FIJO_3.csv
01_Data/00_Inputs/PPED-AreaSexoEdadMun-2018-2042_VP.xlsx
01_Data/01_Derived/poblacion_total.dta
01_Data/00_Inputs/MICRODATOS ECV 2023.dta
01_Data/00_Inputs/Data anonimizada encuesta percepcion 2018-2025.xlsx
01_Data/00_Inputs/Indicadores_ECV2023.xlsx

# --- Derivados grandes y regenerables ---
# ECV_raw.dta (38 MB) lo produce 02_Code/01_homogeneizacion/ecv.R a partir de
# INDICADORES ECV 2023 MUNICIPIOS.xlsx, que sí está versionado.
ECV_raw.dta

# --- Temporales de Excel ---
~$*
**/~$*

# --- RStudio / R ---
.Rproj.user/
.Rhistory
.RData
renv/library/
renv/local/
renv/cellar/
renv/sandbox/
renv/staging/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Stata ---
*.stpr
*.stpm
_tmp_*.dta

# --- Logs de ejecución batch ---
*.log

# --- Outputs de referencia para validar la migración ---
# Se regeneran: tests/referencia con tests/extraer_referencia_anexo1.py (del Anexo 1,
# que sí está versionado); tests/golden con tests/golden_run.do (requiere licencia Stata)
tests/golden/
tests/referencia/

# --- Sistema operativo ---
.DS_Store
Thumbs.db

# --- Auxiliares de LaTeX (04_Docs) ---
# El .pdf y los fragmentos de tabla SÍ se versionan: son el entregable y su
# evidencia. Lo que no se versiona es lo que produce el compilador.
04_Docs/*.aux
04_Docs/*.fdb_latexmk
04_Docs/*.fls
04_Docs/*.out
04_Docs/*.toc
04_Docs/*.synctex.gz

# --- Borradores provinciales (se regeneran) ---
# Los .docx pesan ~9 MB cada uno y se rehacen con
#   Rscript 02_Code/05_documento/generar_borrador.R
# Lo que el equipo redacte va en su copia de trabajo, no aquí.
04_Docs/borradores/*/*.docx

# --- Salidas del pipeline (se regeneran con: Rscript 02_Code/run_all.R) ---
# 144 MB de tablas y figuras que cambian en cada corrida. No se versionan: el
# pipeline las rehace en unos minutos y el repositorio no carga con binarios
# que se reescriben enteros cada vez.
03_Outputs/*/
!03_Outputs/README.md
